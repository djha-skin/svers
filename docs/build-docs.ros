#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -R +Q -- $0 "$@"
|#
(progn
  (ros:ensure-asdf)
  (handler-case
      (asdf:load-system "codex")
    (error (e)
      (format *error-output* "~&Failed to load codex: ~A~%" e)
      (uiop:quit 1))))

(progn
  (handler-case
      (asdf:load-system "codex-templates")
    (error (e)
      (format *error-output* "~&Failed to load codex-templates: ~A~%" e)
      (uiop:quit 1))))

(progn
  (handler-case
      (codex:document "com.djhaskin.svers")
    (error (e)
      (format *error-output* "~&Build failed: ~A~%" e)
      (uiop:quit 1))))
;;; vim: set ft=lisp lisp: